{
  "name": "boilerplate",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "turbo run format",
    "api:build": "cd apps/api && ./gradlew clean build --no-daemon -x test --quiet",
    "api:dev": "cd apps/api && ./gradlew bootRun",
    "api:test": "cd apps/api && ./gradlew test --no-daemon --quiet",
    "api:test:rerun": "cd apps/api && ./gradlew test --no-daemon  --quiet --rerun-tasks"
  },
  "devDependencies": {
    "turbo": "^2.8.11"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.0.0"
}
